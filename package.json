{
  "name": "browsewright-runner",
  "version": "0.11.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @browsewright/web --filter @browsewright/server dev",
    "dev:web": "pnpm --filter @browsewright/web dev",
    "dev:server": "pnpm --filter @browsewright/server dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @browsewright/server start",
    "runner:package": "bash scripts/package-runner.sh",
    "runner:docker": "docker build -t browsewright/runner:local .",
    "lint": "pnpm -r lint",
    "check": "pnpm -r check",
    "acceptance": "node scripts/acceptance-smoke.mjs"
  }
}